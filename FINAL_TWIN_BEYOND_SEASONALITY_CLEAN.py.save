import os
import random
import numpy as np
import pandas as pd
import torch
import torch.nn as nn


# ============================================================
# CONFIG
# ============================================================

BASE = os.path.expanduser("~/Downloads/Crop_Digital_Twin")

DATA = os.path.join(BASE, "GLOBAL_ALL25_MODEL_READY.csv")

OBS_CKPT = os.path.join(
    BASE, "models", "GLOBAL_LATENT_OBSERVATION_V1.pt"
)

TRANS_CKPT = os.path.join(
    BASE, "models", "GLOBAL_LATENT_TRANSITION_V1.pt"
)

OUT = os.path.join(
    BASE, "FINAL_TWIN_BEYOND_SEASONALITY_RESULTS.csv"
)

SEED = 42
N_BOOT = 10000

STATE = [
    "NDVI",
    "EVI",
    "NDWI",
    "VV",
    "VH",
    "VV_VH",
]

WEATHER = [
    "temperature_C",
    "precipitation_mm",
    "solar_MJ_m2",
]

S2 = ["NDVI", "EVI", "NDWI"]
S1 = ["VV", "VH", "VV_VH"]

FEATURES = STATE


# ============================================================
# REPRODUCIBILITY
# ============================================================

np.random.seed(SEED)
random.seed(SEED)
torch.manual_seed(SEED)

DEVICE = torch.device(
    "mps" if torch.backends.mps.is_available() else "cpu"
)

print("=" * 70)
print("FINAL TEST: DOES THE TWIN ADD ANYTHING BEYOND SEASONALITY?")
print("NO RETRAINING")
print("=" * 70)
print("DEVICE:", DEVICE)


# ============================================================
# MODEL DEFINITIONS
# ============================================================

class Encoder(nn.Module):

    def __init__(self):
        super().__init__()

        self.net = nn.Sequential(
            nn.Linear(6, 32),
            nn.Tanh(),
            nn.Linear(32, 4)
        )

    def forward(self, x):
        return self.net(x)


class ObservationModel(nn.Module):

    def __init__(self):
        super().__init__()

        self.encoder = Encoder()

        self.s1_head = nn.Sequential(
            nn.Linear(4, 16),
            nn.Tanh(),
            nn.Linear(16, 3)
        )

        self.s2_head = nn.Sequential(
            nn.Linear(4, 16),
            nn.Tanh(),
            nn.Linear(16, 3)
        )

    def forward(self, x):

        z = self.encoder(x)

        return (
            z,
            self.s1_head(z),
            self.s2_head(z)
        )


class LatentTransition(nn.Module):

    def __init__(self):
        super().__init__()

        self.crop_embedding = nn.Embedding(5, 4)

        self.net = nn.Sequential(
            nn.Linear(17, 32),
            nn.Tanh(),
            nn.Linear(32, 32),
            nn.Tanh(),
            nn.Linear(32, 4)
        )

    def forward(self, z, weather, crop_id):

        emb = self.crop_embedding(crop_id)

        x = torch.cat(
            [z, weather, emb],
            dim=1
        )

        return self.net(x)


# ============================================================
# LOAD FROZEN CHECKPOINTS
# ============================================================

obs_ckpt = torch.load(
    OBS_CKPT,
    map_location=DEVICE,
    weights_only=False
)

trans_ckpt = torch.load(
    TRANS_CKPT,
    map_location=DEVICE,
    weights_only=False
)

obs_model = ObservationModel().to(DEVICE)

obs_model.load_state_dict(
    obs_ckpt["model_state_dict"]
)

obs_model.eval()

transition_model = LatentTransition().to(DEVICE)

transition_model.load_state_dict(
    trans_ckpt["model_state_dict"]
)

transition_model.eval()

state_mean = np.asarray(
    trans_ckpt["state_mean"],
    dtype=np.float32
)

state_std = np.asarray(
    trans_ckpt["state_std"],
    dtype=np.float32
)

weather_mean = np.asarray(
    trans_ckpt["weather_mean"],
    dtype=np.float32
)

weather_std = np.asarray(
    trans_ckpt["weather_std"],
    dtype=np.float32
)

crop_to_id = trans_ckpt["crop_to_id"]

print("\nFROZEN CHECKPOINTS LOADED")
print("Observation:", OBS_CKPT)
print("Transition:", TRANS_CKPT)
print("No optimizer.")
print("No backward pass.")
print("No training.")


# ============================================================
# LOAD DATA
# ============================================================

df = pd.read_csv(DATA)

df["date"] = pd.to_datetime(df["date"])

df = df.sort_values(
    ["site_id", "date"]
).reset_index(drop=True)


# ============================================================
# BUILD 2019-2022 MONTHLY CLIMATOLOGY
# ============================================================

hist = df[
    (df["date"].dt.year >= 2019) &
    (df["date"].dt.year <= 2022)
].copy()

hist["month_num"] = hist["date"].dt.month

clim = (
    hist
    .groupby(
        ["site_id", "month_num"]
    )[FEATURES]
    .mean()
    .reset_index()
)

global_clim = (
    hist
    .groupby("month_num")[FEATURES]
    .mean()
)


# ============================================================
# 2024 DATA
# ============================================================

test = df[
    (df["date"].dt.year == 2024)
].copy()

test["month_num"] = test["date"].dt.month


# ============================================================
# EXACT COMMON EVALUATION SET
#
# Need:
# current observed state
# next observed state
# 3-month weather history ending at current month
# ============================================================

rows = []

for site_id, g in test.groupby("site_id"):

    g = g.sort_values("date").reset_index(drop=True)

    full_site = df[
        df["site_id"] == site_id
    ].sort_values("date").reset_index(drop=True)

    for i in range(len(g) - 1):

        current_date = g.loc[i, "date"]
        next_date = g.loc[i + 1, "date"]

        # Require consecutive months
        if (
            next_date
            != current_date + pd.DateOffset(months=1)
        ):
            continue

        current = g.iloc[i]
        target = g.iloc[i + 1]

        # Current state complete
        if current[STATE].isna().any():
            continue

        # Target state complete
        if target[STATE].isna().any():
            continue

        # Find previous 2 months + current month
        weather_dates = [
            current_date - pd.DateOffset(months=2),
            current_date - pd.DateOffset(months=1),
            current_date,
        ]

        wh = full_site[
            full_site["date"].isin(weather_dates)
        ].copy()

        if len(wh) != 3:
            continue

        wh = wh.sort_values("date")

        if wh[WEATHER].isna().any().any():
            continue

        rows.append({
            "site_id": site_id,
            "crop": current["crop"],
            "country": current["country"],
            "date": current_date,
            "target_date": next_date,

            **{
                f"state_{f}": float(current[f])
                for f in STATE
            },

            **{
                f"target_{f}": float(target[f])
                for f in STATE
            },

            **{
                f"w0_{f}": float(
                    wh.iloc[0][f]
                )
                for f in WEATHER
            },

            **{
                f"w1_{f}": float(
                    wh.iloc[1][f]
                )
                for f in WEATHER
            },

            **{
                f"w2_{f}": float(
                    wh.iloc[2][f]
                )
                for f in WEATHER
            },
        })


ev = pd.DataFrame(rows)

print("\nFIXED EVALUATION SET")
print("Site-months:", len(ev))
print("Sites:", ev["site_id"].nunique())
print(
    "Dates:",
    ev["date"].min().date(),
    "to",
    ev["date"].max().date()
)


# ============================================================
# STANDARDIZATION HELPERS
# ============================================================

def standardize_state(x):

    return (
        x - state_mean
    ) / state_std


def standardize_weather(x):

    return (
        x - weather_mean
    ) / weather_std


def encode_state(raw_state):

    x = standardize_state(
        np.asarray(raw_state, dtype=np.float32)
    )

    xt = torch.tensor(
        x,
        dtype=torch.float32,
        device=DEVICE
    ).reshape(1, 6)

    with torch.no_grad():

        z, _, _ = obs_model(xt)

    return z


def decode_latent(z):

    with torch.no_grad():

        _, s1, s2 = obs_model.encoder(z), None, None

        z2 = z

        pred_s1 = obs_model.s1_head(z2)
        pred_s2 = obs_model.s2_head(z2)

    # state order is NDVI,EVI,NDWI,VV,VH,VV_VH
    pred = torch.cat(
        [pred_s2, pred_s1],
        dim=1
    )

    return pred.cpu().numpy()[0]


# ============================================================
# CROP IDS
# ============================================================

crop_names = list(crop_to_id.keys())

print("\nCrop encoding:")
for c, cid in crop_to_id.items():
    print(c, "->", cid)


# ============================================================
# WEATHER HISTORY
# ============================================================

def get_weather(row):

    vals = []

    for prefix in ["w0", "w1", "w2"]:

        vals.extend([
            row[f"{prefix}_{f}"]
            for f in WEATHER
        ])

    vals = np.asarray(
        vals,
        dtype=np.float32
    )

    # checkpoint expects 3 months x 3 weather variables
    # standardize each weather variable using its train statistics
    out = []

    for j in range(3):

        block = vals[
            j * 3:(j + 1) * 3
        ]

        out.extend(
            (block - weather_mean)
            / weather_std
        )

    return np.asarray(
        out,
        dtype=np.float32
    )


# ============================================================
# LATENT MODEL PREDICTION
# ============================================================

def latent_prediction(
    row,
    weather_override=None,
    crop_override=None
):

    raw_state = np.asarray(
        [
            row[f"state_{f}"]
            for f in STATE
        ],
        dtype=np.float32
    )

    z = encode_state(raw_state)

    if weather_override is None:

        w = get_weather(row)

    else:

        w = np.asarray(
            weather_override,
            dtype=np.float32
        )

    w = torch.tensor(
        w,
        dtype=torch.float32,
        device=DEVICE
    ).reshape(1, 9)

    crop = (
        row["crop"]
        if crop_override is None
        else crop_override
    )

    cid = crop_to_id[crop]

    cid = torch.tensor(
        [cid],
        dtype=torch.long,
        device=DEVICE
    )

    with torch.no_grad():

        dz = transition_model(
            z,
            w,
            cid
        )

        z_next = z + dz

        pred_std = decode_latent(
            z_next
        )

    # Return standardized observation prediction.
    return pred_std


# ============================================================
# TARGET STANDARDIZATION
# ============================================================

def target_standardized(row):

    raw = np.asarray(
        [
            row[f"target_{f}"]
            for f in STATE
        ],
        dtype=np.float32
    )

    return (
        raw - state_mean
    ) / state_std


# ============================================================
# CLIMATOLOGY
# ============================================================

def climatology_prediction(row):

    site = row["site_id"]
    month = int(
        pd.Timestamp(row["target_date"]).month
    )

    x = clim[
        (clim["site_id"] == site) &
        (clim["month_num"] == month)
    ]

    if len(x) == 1:

        raw = x.iloc[0][FEATURES].values.astype(
            np.float32
        )

    else:

        raw = global_clim.loc[
            month
        ][FEATURES].values.astype(
            np.float32
        )

    return (
        raw - state_mean
    ) / state_std


# ============================================================
# ANOMALY PERSISTENCE
#
# Forecast:
# target climatology
# + current anomaly relative to current-month climatology.
# ============================================================

def anomaly_persistence_prediction(row):

    site = row["site_id"]

    current_month = int(
        pd.Timestamp(row["date"]).month
    )

    target_month = int(
        pd.Timestamp(row["target_date"]).month
    )

    # Current climatology
    c0 = clim[
        (clim["site_id"] == site) &
        (clim["month_num"] == current_month)
    ]

    # Target climatology
    c1 = clim[
        (clim["site_id"] == site) &
        (clim["month_num"] == target_month)
    ]

    if len(c0) != 1:
        c0_raw = global_clim.loc[
            current_month
        ][FEATURES].values.astype(np.float32)
    else:
        c0_raw = c0.iloc[0][FEATURES].values.astype(
            np.float32
        )

    if len(c1) != 1:
        c1_raw = global_clim.loc[
            target_month
        ][FEATURES].values.astype(np.float32)
    else:
        c1_raw = c1.iloc[0][FEATURES].values.astype(
            np.float32
        )

    current_raw = np.asarray(
        [
            row[f"state_{f}"]
            for f in STATE
        ],
        dtype=np.float32
    )

    anomaly = current_raw - c0_raw

    forecast_raw = c1_raw + anomaly

    return (
        forecast_raw - state_mean
    ) / state_std


# ============================================================
# RUN BASE PREDICTIONS
# ============================================================

latent_preds = []
clim_preds = []
persist_preds = []

for _, row in ev.iterrows():

    latent_preds.append(
        latent_prediction(row)
    )

    clim_preds.append(
        climatology_prediction(row)
    )

    persist_preds.append(
        anomaly_persistence_prediction(row)
    )


latent_preds = np.asarray(latent_preds)
clim_preds = np.asarray(clim_preds)
persist_preds = np.asarray(persist_preds)

targets = np.asarray([
    target_standardized(row)
    for _, row in ev.iterrows()
])


# ============================================================
# RMSE HELPERS
# ============================================================

def rmse(pred, y):

    return np.sqrt(
        np.mean(
            (pred - y) ** 2
        )
    )


def feature_rmse(pred, y):

    return np.sqrt(
        np.mean(
            (pred - y) ** 2,
            axis=0
        )
    )


print("\n" + "=" * 70)
print("1. ANOMALY PERSISTENCE")
print("=" * 70)

print(
    "Latent RMSE:",
    rmse(latent_preds, targets)
)

print(
    "Anomaly-persistence RMSE:",
    rmse(persist_preds, targets)
)


# ============================================================
# PAIRED SITE BOOTSTRAP
# ============================================================

site_ids = ev["site_id"].unique()


def site_rmse_difference(
    pred_a,
    pred_b
):

    differences = []

    for site in site_ids:

        mask = (
            ev["site_id"].values
            == site
        )

        ra = rmse(
            pred_a[mask],
            targets[mask]
        )

        rb = rmse(
            pred_b[mask],
            targets[mask]
        )

        differences.append(
            ra - rb
        )

    return np.asarray(
        differences
    )


latent_minus_persist = site_rmse_difference(
    latent_preds,
    persist_preds
)

latent_minus_clim = site_rmse_difference(
    latent_preds,
    clim_preds
)


def bootstrap_ci(values):

    n = len(values)

    rng = np.random.default_rng(SEED)

    boots = np.empty(N_BOOT)

    for i in range(N_BOOT):

        sample = rng.choice(
            values,
            size=n,
            replace=True
        )

        boots[i] = np.mean(sample)

    return np.percentile(
        boots,
        [2.5, 97.5]
    )


ci_persist = bootstrap_ci(
    latent_minus_persist
)

print(
    "Mean paired site RMSE difference:",
    np.mean(latent_minus_persist)
)

print(
    "95% site-bootstrap CI:",
    ci_persist
)

print(
    "Sites:",
    len(site_ids)
)


# ============================================================
# FEATURE-LEVEL ANOMALY-PERSISTENCE COMPARISON
# ============================================================

print("\nFeature-level RMSE:")

lr = feature_rmse(
    latent_preds,
    targets
)

pr = feature_rmse(
    persist_preds,
    targets
)

cr = feature_rmse(
    clim_preds,
    targets
)

for j, f in enumerate(FEATURES):

    print(
        f"{f:8s} "
        f"latent={lr[j]:.6f} "
        f"persistence={pr[j]:.6f} "
        f"climatology={cr[j]:.6f} "
        f"latent-persistence={lr[j]-pr[j]:.6f}"
    )


# ============================================================
# TEST-TIME ABLATIONS
#
# Weather shuffle:
# choose another site-month from same crop and same calendar
# month, then use its 3-month weather history.
#
# Crop swap:
# cyclically replace crop with another crop.
# ============================================================

print("\n" + "=" * 70)
print("2. TEST-TIME ABLATIONS")
print("=" * 70)


# Build donor pool
donor_pool = {}

for _, row in ev.iterrows():

    key = (
        row["crop"],
        pd.Timestamp(
            row["date"]
        ).month
    )

    donor_pool.setdefault(
        key,
        []
    ).append(
        get_weather(row)
    )


# Deterministic RNG
rng = np.random.default_rng(SEED)

weather_shuffle_preds = []
crop_swap_preds = []
both_preds = []


crop_list = list(
    crop_to_id.keys()
)


for idx, (_, row) in enumerate(
    ev.iterrows()
):

    key = (
        row["crop"],
        pd.Timestamp(
            row["date"]
        ).month
    )

    donors = donor_pool[key]

    # Choose a donor weather history.
    # Prefer a different history when possible.
    if len(donors) > 1:

        donor_idx = rng.integers(
            0,
            len(donors)
        )

        shuffled_weather = donors[
            donor_idx
        ]

    else:

        shuffled_weather = donors[0]

    # Crop swap: deterministic next crop
    current_crop = row["crop"]

    current_index = crop_list.index(
        current_crop
    )

    swapped_crop = crop_list[
        (current_index + 1)
        % len(crop_list)
    ]

    weather_shuffle_preds.append(
        latent_prediction(
            row,
            weather_override=shuffled_weather
        )
    )

    crop_swap_preds.append(
        latent_prediction(
            row,
            crop_override=swapped_crop
        )
    )

    both_preds.append(
        latent_prediction(
            row,
            weather_override=shuffled_weather,
            crop_override=swapped_crop
        )
    )


weather_shuffle_preds = np.asarray(
    weather_shuffle_preds
)

crop_swap_preds = np.asarray(
    crop_swap_preds
)

both_preds = np.asarray(
    both_preds
)


base_rmse = rmse(
    latent_preds,
    targets
)

weather_rmse = rmse(
    weather_shuffle_preds,
    targets
)

crop_rmse = rmse(
    crop_swap_preds,
    targets
)

both_rmse = rmse(
    both_preds,
    targets
)

print(
    f"Correct weather + crop: {base_rmse:.6f}"
)

print(
    f"Shuffled weather:        {weather_rmse:.6f} "
    f"Δ={weather_rmse-base_rmse:+.6f}"
)

print(
    f"Swapped crop:            {crop_rmse:.6f} "
    f"Δ={crop_rmse-base_rmse:+.6f}"
)

print(
    f"Both ablated:             {both_rmse:.6f} "
    f"Δ={both_rmse-base_rmse:+.6f}"
)


# Feature-level ablations

print("\nFeature-level ablations:")

base_f = feature_rmse(
    latent_preds,
    targets
)

weather_f = feature_rmse(
    weather_shuffle_preds,
    targets
)

crop_f = feature_rmse(
    crop_swap_preds,
    targets
)

both_f = feature_rmse(
    both_preds,
    targets
)

for j, f in enumerate(FEATURES):

    print(
        f"{f:8s} "
        f"weatherΔ={weather_f[j]-base_f[j]:+.6f} "
        f"cropΔ={crop_f[j]-base_f[j]:+.6f} "
        f"bothΔ={both_f[j]-base_f[j]:+.6f}"
    )


# ============================================================
# 3. WEATHER-ANOMALY STRATA
# ============================================================

print("\n" + "=" * 70)
print("3. WEATHER-ANOMALY STRATA")
print("=" * 70)


# 2019-2022 site-month temperature climatology
temp_clim = (
    hist
    .assign(
        month_num=hist["date"].dt.month
    )
    .groupby(
        ["site_id", "month_num"]
    )["temperature_C"]
    .mean()
)


abs_anomaly = []

for _, row in ev.iterrows():

    key = (
        row["site_id"],
        pd.Timestamp(
            row["date"]
        ).month
    )

    if key in temp_clim.index:

        c = temp_clim.loc[key]

    else:

        c = hist[
            hist["date"].dt.month
            == pd.Timestamp(
                row["date"]
            ).month
        ]["temperature_C"].mean()

    abs_anomaly.append(
        abs(
            row["w2_temperature_C"]
            - c
        )
    )


ev["abs_temp_anomaly"] = abs_anomaly


q1, q2 = np.quantile(
    ev["abs_temp_anomaly"],
    [1/3, 2/3]
)

ev["temp_tercile"] = pd.cut(
    ev["abs_temp_anomaly"],
    bins=[
        -np.inf,
        q1,
        q2,
        np.inf
    ],
    labels=[
        "low",
        "middle",
        "high"
    ]
)


# Need climatology prediction and latent prediction
# aligned to ev rows.

for label in [
    "low",
    "middle",
    "high"
]:

    mask = (
        ev["temp_tercile"].values
        == label
    )

    if mask.sum() == 0:
        continue

    latent_r = rmse(
        latent_preds[mask],
        targets[mask]
    )

    clim_r = rmse(
        clim_preds[mask],
        targets[mask]
    )

    print(
        f"{label:7s} "
        f"N={mask.sum():3d} "
        f"temp_anomaly_mean="
        f"{ev.loc[mask, 'abs_temp_anomaly'].mean():.4f} "
        f"latent_RMSE={latent_r:.6f} "
        f"climatology_RMSE={clim_r:.6f} "
        f"latent-minus-climatology="
        f"{latent_r-clim_r:+.6f}"
    )


# ============================================================
# SAVE RESULTS
# ============================================================

summary = pd.DataFrame({

    "metric": [
        "latent_rmse",
        "anomaly_persistence_rmse",
        "latent_minus_persistence",
        "persistence_ci_low",
        "persistence_ci_high",
        "weather_shuffle_rmse",
        "weather_shuffle_delta",
        "crop_swap_rmse",
        "crop_swap_delta",
        "both_ablation_rmse",
        "both_ablation_delta",
    ],

    "value": [
        base_rmse,
        rmse(
            persist_preds,
            targets
        ),
        np.mean(
            latent_minus_persist
        ),
        ci_persist[0],
        ci_persist[1],
        weather_rmse,
        weather_rmse - base_rmse,
        crop_rmse,
        crop_rmse - base_rmse,
        both_rmse,
        both_rmse - base_rmse,
    ]
})

summary.to_csv(
    OUT,
    index=False
)

print("\nSaved:", OUT)

print("\nDONE.")
